# Fifth Element Ceramics — HTTP headers
# NOTE: Pure GitHub Pages does NOT apply this file.
# Works on Cloudflare Pages, Netlify, or GitHub Pages behind Cloudflare proxy rules.
# See: https://developers.cloudflare.com/pages/configuration/headers/

# Security headers (all routes)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Long-lived cache for uploaded media and static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stylesheets — 7 days + stale-while-revalidate
/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/base.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/style.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# JSON data — short cache for CMS updates
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# HTML pages — revalidate hourly
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/index.html
  Cache-Control: public, max-age=3600, must-revalidate

/catalog.html
  Cache-Control: public, max-age=3600, must-revalidate

# Admin — never cache
/cms/*
  Cache-Control: no-store, no-cache, must-revalidate
